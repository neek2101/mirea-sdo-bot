# Токен бота от @BotFather
BOT_TOKEN=

# Ключ шифрования сессий в базе (≥32 случайных символа). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Не теряй и не меняй: без него сохранённые сессии не расшифровать, всем придётся войти заново.
# Ротация: новый ключ первым, старый через запятую — старые сессии продолжат читаться.
SECRET_KEY=

# Как часто проверять СДО, минут (не меньше 5). Не делай слишком часто — пожалей сервер МИРЭА.
POLL_INTERVAL_MINUTES=15
# Сколько пользователей опрашивать одновременно
POLL_CONCURRENCY=3
# Насколько далеко назад смотреть в календаре СДО, дней (чтобы видеть уже открытые тесты)
EVENTS_LOOKBACK_DAYS=30

# Адрес СДО
MOODLE_URL=https://online-edu.mirea.ru

# Прокси до серверов МИРЭА, если они не пускают IP дата-центра (http://… или socks5://…)
MIREA_PROXY=
# Прокси до api.telegram.org, если Telegram недоступен с сервера.
# Нужен дополнительный пакет: pip install "sdo-bot[proxy]"
TELEGRAM_PROXY=

LOG_LEVEL=INFO
